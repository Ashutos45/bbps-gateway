		{
			"name": "05. Prepaid Plans",
			"item": [
				{
					"name": "Query Plans (GET)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/BOBCOU/BBPS/{{sourceid}}/billpay/plans?operator=Tamil Nadu Telecom&circle=Tamil Nadu",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"BOBCOU",
								"BBPS",
								"{{sourceid}}",
								"billpay",
								"plans"
							],
							"query": [
								{
									"key": "operator",
									"value": "Tamil Nadu Telecom"
								},
								{
									"key": "circle",
									"value": "Tamil Nadu"
								}
							]
						}
					},
					"response": []
